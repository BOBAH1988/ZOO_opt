# Переменные окружения для server/index.js (Express run API)
# Копируйте в server/.env и задайте реальные значения. Не коммитьте реальные секреты.

PORT=8787

# Firebase Admin SDK (для проверки Firebase ID token)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# GitHub (серверный токен для workflow_dispatch, хранится только на сервере)
GITHUB_OWNER=BOBAH1988
GITHUB_REPO=mail-automation
GITHUB_TOKEN=your_github_token_with_actions_write

# Allowlist UID, которым разрешено запускать workflow (через запятую).
# Пусто = никто (все получают 403). Это fail-closed поведение.
ALLOWED_UIDS=

# Какие UID могут запускать реальную рассылку (test_mode=false).
# Пусто = реальная рассылка запрещена всем.
REAL_SEND_UIDS=

# Разрешённый origin для CORS (обязательно для работы из браузера, например http://localhost:5173 или https://bobah1988.github.io).
# При пустом значении браузерные запросы к Express будут заблокированы CORS.
APP_ORIGIN=
