# Данные клиентов.
#
# Списки получателей рассылок — ОСНОВНОЙ источник правды, поэтому они
# лежат в репозитории: тогда рассылка не зависит ни от Firestore, ни от
# секретов CI. Приложение («Списки») работает поверх этих же адресов,
# а копии для первичного импорта лежат в public/list-seeds/.
#
# Временные и личные списки по-прежнему игнорируются.
mail-automation/scripts/*.local.txt
mail-automation/scripts/*-private.txt

# Данные проекта «Остатки» — приходят из почты, в репозиторий не кладутся
mail-automation/project residues/*.xls
mail-automation/project residues/*.xlsx
mail-automation/project residues/output/*.xlsx
mail-automation/project residues/output/.sent_marker
mail-automation/project residues/data/last_week_pricelist.txt

# Серверные секреты — вне репозитория (~/.config/zoo-opt/server.env)
server/.env
